# Copy to .env and adjust. docker compose reads .env automatically.

# Default dataset for `db`, setup and the scripts (can always be given as an argument)
WVB_DATASET=glove-200-cosine

# --- Common Baseline resource limits -------------------------------------
# Weaviate: 4 pinned cores, 8 GB RAM, swap off. The client gets its own core.
# The CPU ids refer to the Docker VM: with Docker Desktop give the VM >= 5 CPUs
# and ~10 GB RAM (Settings > Resources).
WEAVIATE_CPUS=0-3
CLIENT_CPUS=4
WEAVIATE_MEM_LIMIT=8g
WEAVIATE_GOMAXPROCS=4
# ~85% of WEAVIATE_MEM_LIMIT
WEAVIATE_GOMEMLIMIT=6800MiB

# --- Timing mode -----------------------------------------------------------
# true  -> ingest_s and build_s measured separately (index built from a queue)
# false -> baseline DDL exception: ingest_s = load + index, build_s empty
# After a change: docker compose up -d weaviate (recreates the container)
ASYNC_INDEXING=true

# --- Optional overrides of config/profiles.toml ------------------------------
# WVB_PROFILE=medium
# WVB_PARAMS=ingest.mode=server_side,max_connections=32

# --- Host info logged with every result (the Makefile fills these in) ------
# HOST_CPU_MODEL=Apple M2
# HOST_OS=macOS 15.1
# HOST_RAM_GB=16
# HOST_DISK_TYPE=SSD

# --- Ports published on 127.0.0.1 -------------------------------------------
# WEAVIATE_HTTP_PORT=8080
# WEAVIATE_GRPC_PORT=50051
# WEAVIATE_METRICS_PORT=2112
# WEAVIATE_CONTAINER=wvbench-weaviate
