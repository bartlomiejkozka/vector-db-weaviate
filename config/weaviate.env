# Weaviate server environment (static: nothing here depends on the dataset;
# dataset-dependent settings are collection settings in config/profiles.toml).
# Reference: https://docs.weaviate.io/deploy/configuration/env-vars
#
# Set in docker-compose.yml from .env instead of here, because they must stay in
# sync with other settings:
#   GOMEMLIMIT      (WEAVIATE_GOMEMLIMIT, ~85% of WEAVIATE_MEM_LIMIT)
#   GOMAXPROCS      (WEAVIATE_GOMAXPROCS, = number of pinned cores)
#   ASYNC_INDEXING  (shared with the client container, decides the timing mode)

# Storage: baseline path inside the container
PERSISTENCE_DATA_PATH=/db
# Docs suggest a value close to the HNSW graph size (~0.3-0.7 GB for our datasets)
PERSISTENCE_HNSW_MAX_LOG_SIZE=1GiB

# Resources: explicit GOMEMLIMIT/GOMAXPROCS instead of LIMIT_RESOURCES
# (LIMIT_RESOURCES=true overrides GOMEMLIMIT and uses cores-1)
LIMIT_RESOURCES=false

# Pure self-provided embeddings: no vectorizer modules, no implicit quantization,
# no automatic schema changes
DEFAULT_VECTORIZER_MODULE=none
ENABLE_MODULES=
DEFAULT_QUANTIZATION=none
AUTOSCHEMA_ENABLED=false

# Query limits (k = 100 with headroom)
QUERY_DEFAULTS_LIMIT=10
QUERY_MAXIMUM_RESULTS=10000

# Metrics endpoint on :2112. Sampled by the client only during load/index.
PROMETHEUS_MONITORING_ENABLED=true

# Noise reduction / single local node
AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=true
DISABLE_TELEMETRY=true
LOG_LEVEL=warning
CLUSTER_HOSTNAME=node1
