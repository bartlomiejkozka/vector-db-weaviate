#!/bin/sh
# db <goal> <params...>   e.g. db 1 443321 4
# Works in the client container (PYTHONPATH=/app/src) and locally from the repository root.
here="$(cd "$(dirname "$0")" && pwd)"
if [ -d "$here/src/wvbench" ]; then
    PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
    PY="$here/.venv/bin/python"
    [ -x "$PY" ] || PY=python3
else
    PY=python
fi
exec "$PY" -m wvbench.cli "$@"
